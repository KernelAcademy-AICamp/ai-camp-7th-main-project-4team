#!/bin/sh
# 커밋에 포함된 파일 종류에 따라 생성물을 자동 갱신·스테이징한다.
# 설정: git config core.hooksPath .githooks  (클론 후 한 번)

staged=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACM)

# Python 실행기 — 맥/리눅스는 python3, 윈도우는 py 런처(python3 이 없다).
# node 를 거치지 않는다: nvm 을 쓰면 훅 환경(특히 GUI 클라이언트)에 node 가
# PATH 에 없을 수 있어서, 훅이 node 에 의존하면 맥에서 오히려 잘 깨진다.
# command -v 로 존재만 보면 안 된다 — 윈도우엔 실행하면 실패하는(종료코드 49)
# Microsoft Store 앱 실행 별칭 python3 이 PATH 에 있다. 실제로 돌려서 판정한다.
if python3 --version >/dev/null 2>&1; then PY="python3"
elif py -3 --version >/dev/null 2>&1; then PY="py -3"
else
  echo "✗ Python 을 찾을 수 없습니다 (python3 · py 둘 다 실행 실패)" >&2
  exit 1
fi

# 1) docs/*.md·뷰어 템플릿(_tpl.html) → 통합문서.html 재생성
if printf '%s\n' "$staged" | grep -qE '^docs/([^/]+\.md|html/_src/_tpl\.html)$'; then
  if [ -f web/docs.html ]; then FLAG="--web"; else FLAG=""; fi   # web 배포 임시본 있으면 같이 갱신(미추적)
  if ! $PY docs/html/_src/build.py $FLAG >/dev/null; then
    echo "✗ 통합문서.html 자동 재생성 실패 — Python / docs/html/_src/build.py 확인" >&2
    exit 1
  fi
  git add docs/html/통합문서.html
  echo "✓ 통합문서.html 자동 재생성 (docs md/템플릿 변경 감지)"
fi

# 2) web/css/*.css·web/js/*.js → 캐시버스트 ?v=<내용해시> 재스탬프 후, 바뀐 html만 정확히 스테이징
if printf '%s\n' "$staged" | grep -qE '^web/(css|js)/[^/]+\.(css|js)$'; then
  changed=$($PY scripts/stamp-assets.py --print-changed) || {
    echo "✗ 에셋 캐시버스트 스탬프 실패 — scripts/stamp-assets.py 확인" >&2; exit 1; }
  if [ -n "$changed" ]; then
    printf '%s\n' "$changed" | while IFS= read -r f; do git add "$f"; done
    echo "✓ 에셋 ?v= 재스탬프 (web/css·js 변경 감지): $changed"
  fi
fi

exit 0
