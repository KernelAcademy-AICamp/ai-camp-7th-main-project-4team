.DS_Store
.vercel
node_modules

# 비밀키·환경변수 — 절대 커밋 금지 (.env.example만 추적)
.env
.env.local
.env.*.local

# Next.js·빌드 산출물 (마일스톤1 이후)
.next/
out/
dist/

# app/ = web/에서 gen-app로 생성하는 프로덕션 빌드(생성물). Vercel이 빌드에서 재생성.
app/

# 대용량 원본(사이즈코리아 XLSX) — clean CSV가 사용본
data/body/raw/
demo/
.env*

# 사이즈표 캡처 — 쇼핑몰 스크린샷(브랜드 저작물)·수집 메모.
# 폴더 자체는 유지(.gitkeep 추적), 안의 파일은 전부 제외.
data/brand/raw/size-tables/*
!data/brand/raw/size-tables/.gitkeep

# Claude Code 기억 백업 — 저장소 밖(~/.claude/…)에 있는 것을 PC 이동용으로 복사해 둔 것.
# 폴더를 통째로 옮길 때만 따라가면 되고, git에는 올리지 않는다(개인 작업 맥락 + 팀 공유 대상 아님).
# 복구 방법은 .claude-memory/_복구방법.md
.claude-memory/
